# Builder stage to compile gosu with an updated Go toolchain (resolves CVE-2026-46600)
FROM golang:1.24-alpine3.21 AS gosu-builder

ENV CGO_ENABLED=0

RUN go install github.com/tianon/gosu@1.17

FROM mongo:8.0

# Replace base image gosu binary with patched version
COPY --from=gosu-builder /go/bin/gosu /usr/local/bin/gosu
RUN chmod +x /usr/local/bin/gosu

# Add initialization scripts
COPY mongo-init.js /docker-entrypoint-initdb.d/

# Add basic health check
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
  CMD mongosh --quiet --eval "db.adminCommand('ping')" || exit 1
